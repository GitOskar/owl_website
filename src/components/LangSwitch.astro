---
import { ui, languages, languageNames, homePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  up?: boolean;
}

const { lang, up = false } = Astro.props;
const t = ui[lang];
---

<details class:list={['switch', { up }]}>
  <summary aria-label={t.language}>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18"></path></svg>
    <span>{lang.toUpperCase()}</span>
    <svg class="chev" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
  </summary>
  <ul>
    {languages.map((l) => (
      <li>
        <a href={homePath(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{languageNames[l]}</a>
      </li>
    ))}
  </ul>
</details>

<script>
  const switches = document.querySelectorAll<HTMLDetailsElement>('details.switch');
  const closeAll = (except?: Element | null) => {
    for (const el of switches) if (el !== except) el.open = false;
  };
  document.addEventListener('click', (e) => closeAll((e.target as Element).closest('details.switch')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>

<style>
  .switch { position: relative; font-family: var(--font-display); font-size: 0.85rem; letter-spacing: 0.12em; }
  summary { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.6rem; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; cursor: pointer; list-style: none; transition: color 0.2s, border-color 0.2s; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, summary:focus-visible, .switch[open] summary { color: var(--fg); border-color: var(--owl-hot); }
  .chev { transition: transform 0.2s; }
  .switch[open] .chev { transform: rotate(180deg); }
  ul { position: absolute; right: 0; top: calc(100% + 0.4rem); z-index: 20; min-width: 100%; margin: 0; padding: 0.3rem; list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  .up ul { top: auto; bottom: calc(100% + 0.4rem); }
  a { display: block; padding: 0.4rem 0.7rem; color: var(--muted); text-decoration: none; letter-spacing: 0.06em; white-space: nowrap; border-radius: 5px; }
  a:hover, a:focus-visible { color: var(--fg); background: color-mix(in srgb, var(--owl) 14%, transparent); }
  a[aria-current] { color: var(--owl-hot); }
  @media (max-width: 560px) {
    .switch { font-size: 0.72rem; letter-spacing: 0.06em; }
    summary { gap: 0.3rem; padding: 0.2rem 0.45rem; }
    summary > svg:first-child { display: none; }
  }
  @media (max-width: 400px) {
    .switch { font-size: 0.62rem; }
    summary { padding: 0.2rem 0.35rem; gap: 0.2rem; }
    .chev { width: 9px; height: 9px; }
  }
  @media (prefers-reduced-motion: reduce) {
    summary, .chev { transition: none; }
  }
</style>
