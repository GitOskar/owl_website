<style>
  .owl-btn {
    all: unset;
    display: block;
    width: min(88vw, 560px);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .owl-btn:focus-visible { outline: 2px solid var(--owl-hot); outline-offset: 8px; border-radius: 4px; }
  .owl { display: block; width: 100%; height: auto; overflow: visible; }
  .owl * { transform-box: fill-box; }

  .part {
    fill: var(--owl);
    stroke: var(--owl);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .owl .wing { transform-box: view-box; }
  .wl { transform-origin: 584px 300px; }
  .wr { transform-origin: 698px 300px; }
  .owl .breath { transform-box: view-box; transform-origin: 641px 400px; }
  .f { transform-origin: 50% 0%; }
  .pupil { fill: var(--owl-hot); stroke: none; transform-origin: 50% 50%; }
  .eyes { transform-origin: 50% 50%; animation: blink 6s 3.6s infinite, glow 4.4s 2.9s ease-in-out infinite; }

  .play .part {
    animation: draw 1.3s cubic-bezier(0.6, 0, 0.3, 1) both, fill 0.6s ease-out both;
    animation-delay: var(--d, 0s), calc(var(--d, 0s) + 1.1s);
  }
  .play .body { --d: 0s; }
  .play .head .part { --d: 0.15s; }
  .play .wm .part { --d: 0.3s; }
  .play .wb { --d: 0s; }
  .play .f1 { --d: 0.45s; } .play .f2 { --d: 0.5s; } .play .f3 { --d: 0.55s; } .play .f4 { --d: 0.6s; }

  .play .pupil { animation: ignite 0.5s 1.9s both; }
  .play .wl { animation: open-l 2.4s 1.3s cubic-bezier(0.2, 0.9, 0.2, 1.2) both, sway-l 4.4s 3.7s ease-in-out infinite; }
  .play .wr { animation: open-r 2.4s 1.3s cubic-bezier(0.2, 0.9, 0.2, 1.2) both, sway-r 4.4s 3.7s ease-in-out infinite; }
  .play .wm { animation-delay: 1.38s, 3.78s; }

  .play .breath { animation: breathe 4.4s 2.6s ease-in-out infinite; }
  .play .head { animation: head-lift 4.4s 2.8s ease-in-out infinite; }

  .play .f {
    animation: draw 1.3s both, fill 0.6s both, drop 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.3) both, flutter 4.4s ease-in-out infinite;
    animation-delay: var(--d), calc(var(--d) + 1.1s), calc(var(--d) + 1.2s), calc(2.6s + var(--w, 0s));
  }
  .play .f1 { --rot: -3.5deg; --w: 0.1s; }
  .play .f2 { --rot: 2.5deg; --w: 0.3s; }
  .play .f3 { --rot: -2.5deg; --w: 0.5s; }
  .play .f4 { --rot: 3.5deg; --w: 0.7s; }
  .play .l { animation: draw 1.3s both, fill 0.6s both, rise 0.6s ease-out both; }
  .play .l1 { animation-delay: 0.7s, 1.8s, 1.9s; }
  .play .l2 { animation-delay: 0.75s, 1.9s, 2s; }
  .play .l3 { animation-delay: 0.8s, 2s, 2.1s; }

  @keyframes breathe {
    0%, 100% { transform: scale(1, 1); }
    42% { transform: scale(1.022, 1.032); }
  }
  @keyframes head-lift {
    0%, 100% { transform: translateY(0); }
    46% { transform: translateY(-2.5px); }
  }
  @keyframes glow {
    0%, 100% { opacity: 0.8; }
    46% { opacity: 1; }
  }
  @keyframes flutter {
    0%, 100% { transform: rotate(0deg) scaleY(1); }
    50% { transform: rotate(var(--rot, 3deg)) scaleY(1.06); }
  }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes fill { from { fill-opacity: 0; } to { fill-opacity: 1; } }
  @keyframes ignite {
    0% { fill-opacity: 0; transform: scale(0.2); }
    60% { fill-opacity: 1; transform: scale(1.35); }
    100% { transform: scale(1); }
  }
  @keyframes open-l { from { transform: skewY(8deg) scaleX(0.96); } }
  @keyframes open-r { from { transform: skewY(-8deg) scaleX(0.96); } }
  @keyframes sway-l { 0%, 100% { transform: skewY(0deg); } 50% { transform: skewY(5deg) scaleX(0.985); } }
  @keyframes sway-r { 0%, 100% { transform: skewY(0deg); } 50% { transform: skewY(-5deg) scaleX(0.985); } }
  @keyframes drop { from { transform: translateY(-14px) scaleY(0.6); } }
  @keyframes rise { from { transform: translateY(18px); opacity: 0; } }
  @keyframes blink { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(0.1); } }

  @media (prefers-reduced-motion: reduce) {
    .owl, .owl * { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.owl-btn');
  const svg = btn?.querySelector<SVGSVGElement>('.owl');

  if (btn && svg) {
    btn.addEventListener('click', () => {
      svg.classList.remove('play');
      void svg.getBoundingClientRect();
      svg.classList.add('play');
    });

    const pupils = [...svg.querySelectorAll<SVGPathElement>('.pupil')];
    const boxes = pupils.map((p) => p.getBBox());
    const cur = pupils.map(() => ({ x: 0, y: 0 }));
    const instant = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let px = 0;
    let py = 0;
    let hasPointer = false;
    let raf = 0;
    let last = 0;

    const tick = (now: number) => {
      raf = 0;
      const m = svg.getScreenCTM();
      if (!hasPointer || !m) return;
      const k = instant ? 1 : 1 - Math.exp(-Math.min(now - last, 50) / 45);
      last = now;
      let moving = false;
      pupils.forEach((p, i) => {
        const b = boxes[i];
        const cx = m.a * (b.x + b.width / 2) + m.e;
        const cy = m.d * (b.y + b.height / 2) + m.f;
        const a = Math.atan2(py - cy, px - cx);
        const d = Math.min(1, Math.hypot(px - cx, py - cy) / 120);
        const tx = Math.cos(a) * 6 * d;
        const ty = Math.sin(a) * 4 * d;
        const c = cur[i];
        c.x += (tx - c.x) * k;
        c.y += (ty - c.y) * k;
        if (Math.abs(tx - c.x) > 0.01 || Math.abs(ty - c.y) > 0.01) moving = true;
        p.style.translate = `${c.x}px ${c.y}px`;
      });
      if (moving) raf = requestAnimationFrame(tick);
    };

    window.addEventListener('pointermove', (e) => {
      px = e.clientX;
      py = e.clientY;
      hasPointer = true;
      if (!raf) {
        last = performance.now();
        raf = requestAnimationFrame(tick);
      }
    });
  }
</script>
