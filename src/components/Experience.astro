---
import { content } from '../i18n/content';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { role, cards } = content[lang].experience;
const t = ui[lang];
---

<section id="experience">
  <h2>{t.experience}</h2>

  <div class="role">
    <div>
      <h3>{role.title}</h3>
      <p>{role.context}</p>
    </div>
    <span class="period">{role.period}</span>
  </div>

  <ul class="cards">
    {cards.map((card) => (
      <li>
        <span class="dot" aria-hidden="true"></span>
        <h4>{card.title}</h4>
        <p>{card.summary}</p>
        <ul class="tags">
          {card.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .role { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 1.5rem; padding-bottom: 1.25rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  .role h3 { margin: 0; font-size: 1.2rem; color: var(--fg); }
  .role p { margin-top: 0.15rem; }
  .period { font-family: var(--font-display); font-size: 0.9rem; letter-spacing: 0.06em; color: var(--owl-hot); }
  .cards { position: relative; list-style: none; margin: 0; padding: 0 0 0 2.25rem; display: grid; gap: 1rem; }
  .cards::before, .cards::after { content: ""; position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; border-radius: 1px; }
  .cards::before { background: var(--line); }
  .cards::after { background: linear-gradient(var(--owl), var(--owl-hot)); box-shadow: 0 0 10px rgba(255, 90, 79, 0.5); transform-origin: top; }
  .dot { position: absolute; left: -35px; top: 1.6rem; width: 12px; height: 12px; border-radius: 50%; background: var(--bg); border: 2px solid var(--line); }
  .cards > li { position: relative; display: flex; flex-direction: column; gap: 0.75rem; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem; transition: border-color 0.2s; }
  .cards > li:hover { border-color: var(--owl); }
  h4 { margin: 0; font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; letter-spacing: 0.03em; color: var(--fg); }
  .cards p { font-size: 0.95rem; }
  .tags { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li { font-size: 0.8rem; padding: 0.2rem 0.6rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cards::after { animation-name: line-grow; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: cover 10% cover 78%; }
      .dot { animation-name: light; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 30% entry 70%; }
    }
  }
  @keyframes line-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes light {
    to { background: var(--owl-hot); border-color: var(--owl-hot); box-shadow: 0 0 14px var(--owl-hot); }
  }
  @media (max-width: 560px) {
    .cards { padding-left: 1.75rem; }
    .dot { left: -27px; }
  }
</style>
