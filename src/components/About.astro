---
import { content } from '../i18n/content';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const about = content[lang].about;
const t = ui[lang];
---

<section id="about">
  <h2>{t.about}</h2>
  <div class="intro">
    {about.paragraphs.map((text) => <p>{text}</p>)}
  </div>

  <ul class="highlights">
    {about.highlights.map((item) => (
      <li>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </li>
    ))}
  </ul>

  <div class="block">
    <h3>{about.domain.title}</h3>
    <ul class="list">
      {about.domain.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="block">
    <h3>{t.stack}</h3>
    <div class="groups">
      {about.skillGroups.map((group) => (
        <div class="group">
          <h4>{group.title}</h4>
          <ul class="chips">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <dl class="facts">
    {about.facts.map((fact) => (
      <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
    ))}
  </dl>
</section>

<style>
  .intro { display: grid; gap: 1rem; margin-bottom: 2rem; }
  .highlights { list-style: none; margin: 0 0 2.5rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; }
  .highlights li { display: grid; gap: 0.25rem; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.25rem; }
  .highlights strong { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: 0.04em; color: var(--fg); }
  .highlights span { font-size: 0.9rem; color: var(--muted); }
  .block { margin-bottom: 2.5rem; }
  h3 { margin: 0 0 1rem; font-size: 1.15rem; color: var(--fg); }
  h4 { margin: 0 0 0.5rem; font-family: var(--font-body); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.6rem 2rem; }
  .list li { position: relative; padding-left: 1.2rem; color: var(--fg); }
  .list li::before { content: ""; position: absolute; left: 0; top: 0.65em; width: 6px; height: 6px; border-radius: 50%; background: var(--owl); }
  .groups { display: grid; gap: 1.25rem; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { font-size: 0.88rem; padding: 0.3rem 0.75rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--fg); }
  .facts { display: grid; gap: 0.5rem; margin: 0; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: 0.9rem; }
  .facts div { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  .facts dt { color: var(--muted); }
  .facts dt::after { content: ":"; }
  .facts dd { margin: 0; color: var(--fg); }
</style>
