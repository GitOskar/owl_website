---
import shared from '../data/contact.json';
import { content } from '../i18n/content';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const contact = { ...content[lang].contact, ...shared };
const { company } = contact;
const t = ui[lang];
const iconPaths: Record<string, string> = {
  linkedin: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  github: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
};
---

<section id="contact">
  <h2>{t.contact}</h2>
  <div class="card">
    <p class="availability"><span class="dot" aria-hidden="true"></span>{contact.availability}</p>
    <h3>{contact.heading}</h3>
    <p class="pitch">{contact.pitch}</p>

    <div class="actions">
      <div class="email">
        <a class="cta" href={`mailto:${contact.email}`}>{contact.email}</a>
        <button type="button" class="copy" data-email={contact.email} data-label-copy={t.copyEmail} data-label-done={t.emailCopied} data-label-fail={t.copyFailed} aria-label={t.copyEmail} title={t.copyEmail}>
          <svg class="icon-copy" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
          <svg class="icon-done" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
        </button>
      </div>
      {contact.links.map((link) => (
        <a class="link" href={link.url} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={iconPaths[link.icon]}></path></svg>
          {link.label}
        </a>
      ))}
    </div>

    <p class="response">{contact.responseTime}</p>

    <dl class="company">
      <div><dt>{t.company}</dt><dd>{company.name} ({company.shortName})</dd></div>
      <div><dt>NIP</dt><dd>{company.nip}</dd></div>
      <div><dt>REGON</dt><dd>{company.regon}</dd></div>
    </dl>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
        button.classList.add('done');
        button.setAttribute('aria-label', button.dataset.labelDone ?? '');
        setTimeout(() => {
          button.classList.remove('done');
          button.setAttribute('aria-label', button.dataset.labelCopy ?? '');
        }, 1800);
      } catch {
        button.setAttribute('aria-label', button.dataset.labelFail ?? '');
      }
    });
  });
</script>

<style>
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: clamp(1.25rem, 4vw, 2rem); display: grid; gap: 1rem; }
  .availability { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--fg); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--owl-hot); box-shadow: 0 0 8px var(--owl-hot); }
  h3 { margin: 0; font-size: 1.4rem; }
  .pitch { max-width: 55ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .cta, .link, .copy { font: inherit; font-size: 0.95rem; padding: 0.55rem 1rem; text-decoration: none; cursor: pointer; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .email { display: inline-flex; }
  .cta { background: var(--owl); color: #fff; border: 1px solid var(--owl); border-radius: 8px 0 0 8px; }
  .cta:hover { background: var(--owl-hot); border-color: var(--owl-hot); }
  .copy { display: inline-grid; place-items: center; padding-inline: 0.8rem; background: var(--owl); color: #fff; border: 1px solid var(--owl); border-left-color: rgba(0, 0, 0, 0.35); border-radius: 0 8px 8px 0; }
  .copy:hover { background: var(--owl-hot); border-color: var(--owl-hot); border-left-color: rgba(0, 0, 0, 0.35); }
  .copy svg { grid-area: 1 / 1; }
  .icon-done { display: none; }
  .copy.done .icon-copy { display: none; }
  .copy.done .icon-done { display: block; }
  .link { display: inline-flex; align-items: center; gap: 0.5rem; background: transparent; color: var(--fg); border: 1px solid var(--line); border-radius: 8px; }
  .link:hover { border-color: var(--owl-hot); }
  .response { font-size: 0.9rem; }
  .company { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0; padding-top: 1rem; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--muted); }
  .company div { display: flex; gap: 0.5rem; }
  .company dt { color: var(--muted); }
  .company dt::after { content: ":"; }
  .company dd { margin: 0; color: var(--fg); }
</style>
